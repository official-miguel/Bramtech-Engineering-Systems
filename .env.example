# Public site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase (reviews storage only, no admin page)
NEXT_PUBLIC_SUPABASE_URL=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Salt used to hash visitor IPs for rate limiting
IP_HASH_SALT=change-me

# Optional: Cloudflare Turnstile (leave empty to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Plausible analytics (leave empty to disable)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
